<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Pixel Dash - Pixel Games</title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body {
      background: #050814;
      color: white;
      font-family: 'Courier New', Courier, monospace;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      overflow: hidden;
    }

    h1 {
      color: #00e5ff;
      text-shadow: 0 0 10px #00e5ff;
      margin-bottom: 10px;
      font-size: 28px;
    }

    #game-container {
      position: relative;
      width: 800px;
      max-width: 95vw;
      height: 300px;
      background: #0d1322;
      border: 2px solid #00e5ff;
      border-radius: 12px;
      box-shadow: 0 0 20px rgba(0, 229, 255, 0.3);
      overflow: hidden;
    }

    canvas {
      width: 100%;
      height: 100%;
      display: block;
    }

    .ui-overlay {
      position: absolute;
      top: 10px;
      left: 15px;
      right: 15px;
      display: flex;
      justify-content: space-between;
      font-size: 18px;
      font-weight: bold;
      color: #fff;
      pointer-events: none;
    }

    .game-over-screen {
      position: absolute;
      top: 0; left: 0; width: 100%; height: 100%;
      background: rgba(5, 8, 20, 0.85);
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
      gap: 15px;
    }

    .btn {
      padding: 12px 24px;
      background: linear-gradient(180deg, #00e5ff, #0088cc);
      color: #000;
      font-weight: bold;
      font-size: 16px;
      border: none;
      border-radius: 8px;
      cursor: pointer;
      transition: transform 0.1s;
    }

    .btn:hover { transform: scale(1.05); }

    .btn-back {
      margin-top: 20px;
      background: linear-gradient(180deg, #ff4757, #c0392b);
      color: white;
      text-decoration: none;
      padding: 10px 20px;
      border-radius: 8px;
      font-weight: bold;
      font-size: 14px;
    }
  </style>
</head>
<body>

  <h1>⚡ PIXEL DASH ⚡</h1>

  <div id="game-container">
    <div class="ui-overlay">
      <div id="score-text">Puntos: 0</div>
      <div id="high-score-text">Récord: 0</div>
    </div>

    <canvas id="gameCanvas"></canvas>

    <div class="game-over-screen" id="start-screen">
      <h2 style="color: #00e5ff;">¿LISTO PARA SALTAR?</h2>
      <p style="color: #aaa; font-size: 14px;">Presiona ESPACIO o TOCA la pantalla</p>
      <button class="btn" onclick="startGame()">JUGAR</button>
    </div>
  </div>

  <a href="juegos.html" class="btn-back">VOLVER AL MENÚ</a>

  <script>
    const canvas = document.getElementById('gameCanvas');
    const ctx = canvas.getContext('2d');

    canvas.width = 800;
    canvas.height = 300;

    let isPlaying = false;
    let score = 0;
    let highScore = localStorage.getItem('dash_highscore') || 0;
    document.getElementById('high-score-text').textContent = `Récord: ${highScore}`;

    let player = {
      x: 80,
      y: 220,
      size: 30,
      vy: 0,
      gravity: 0.8,
      jumpForce: -13,
      jumpsLeft: 2,
      grounded: false
    };

    let obstacles = [];
    let frameCount = 0;
    let gameSpeed = 6;

    function startGame() {
      document.getElementById('start-screen').style.display = 'none';
      player.y = 220;
      player.vy = 0;
      player.jumpsLeft = 2;
      obstacles = [];
      score = 0;
      gameSpeed = 6;
      frameCount = 0;
      isPlaying = true;
      requestAnimationFrame(gameLoop);
    }

    function jump() {
      if (!isPlaying) return;
      if (player.jumpsLeft > 0) {
        player.vy = player.jumpForce;
        player.jumpsLeft--;
      }
    }

    window.addEventListener('keydown', (e) => {
      if (e.code === 'Space' || e.code === 'ArrowUp') {
        e.preventDefault();
        jump();
      }
    });

    canvas.addEventListener('touchstart', (e) => {
      e.preventDefault();
      jump();
    });

    function spawnObstacle() {
      let height = Math.floor(Math.random() * 30) + 30;
      let isFlying = Math.random() > 0.7;

      obstacles.push({
        x: canvas.width,
        y: isFlying ? 150 : 250 - height,
        w: 25,
        h: height,
        color: isFlying ? '#ff4757' : '#ffda00'
      });
    }

    function gameLoop() {
      if (!isPlaying) return;

      frameCount++;
      if (frameCount % 90 === 0) {
        spawnObstacle();
        if (gameSpeed < 14) gameSpeed += 0.2;
      }

      // Física del jugador
      player.vy += player.gravity;
      player.y += player.vy;

      if (player.y >= 220) {
        player.y = 220;
        player.vy = 0;
        player.grounded = true;
        player.jumpsLeft = 2;
      }

      // Limpiar pantalla
      ctx.clearRect(0, 0, canvas.width, canvas.height);

      // Dibujar Suelo
      ctx.strokeStyle = '#00e5ff';
      ctx.lineWidth = 3;
      ctx.beginPath();
      ctx.moveTo(0, 250);
      ctx.lineTo(canvas.width, 250);
      ctx.stroke();

      // Dibujar Jugador (Neón Azul)
      ctx.fillStyle = '#00e5ff';
      ctx.shadowBlur = 15;
      ctx.shadowColor = '#00e5ff';
      ctx.fillRect(player.x, player.y, player.size, player.size);

      // Mover y Dibujar Obstáculos
      for (let i = obstacles.length - 1; i >= 0; i--) {
        let obs = obstacles[i];
        obs.x -= gameSpeed;

        ctx.fillStyle = obs.color;
        ctx.shadowBlur = 10;
        ctx.shadowColor = obs.color;
        ctx.fillRect(obs.x, obs.y, obs.w, obs.h);

        // Colisión
        if (
          player.x < obs.x + obs.w &&
          player.x + player.size > obs.x &&
          player.y < obs.y + obs.h &&
          player.y + player.size > obs.y
        ) {
          gameOver();
          return;
        }

        // Eliminar si sale de pantalla
        if (obs.x + obs.w < 0) {
          obstacles.splice(i, 1);
          score += 10;
          document.getElementById('score-text').textContent = `Puntos: ${score}`;
        }
      }

      ctx.shadowBlur = 0; // Reset sombra
      requestAnimationFrame(gameLoop);
    }

    function gameOver() {
      isPlaying = false;
      if (score > highScore) {
        highScore = score;
        localStorage.setItem('dash_highscore', highScore);
        document.getElementById('high-score-text').textContent = `Récord: ${highScore}`;
      }

      const screen = document.getElementById('start-screen');
      screen.style.display = 'flex';
      screen.querySelector('h2').textContent = '¡GAME OVER!';
      screen.querySelector('p').textContent = `Puntuación: ${score} pts`;
    }
  </script>
</body>
</html>
